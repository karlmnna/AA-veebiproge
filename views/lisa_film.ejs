
<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8">
    <title>Karl Marcus Männa, veebiprogrammeerimine</title>
</head>
<body>
    <img src="/pic/veebiprogrammeerimine_2026_AA.png" alt="banner">
    <h1>Eesti film</h1>
    <p>Siin saab lisada Eesti filme.</p>
    <ul>
        <li><a href="/">Avalehele</a></li>
        <li><a href="/eestifilm">Eesti filmi avalehele</a></li>
    </ul>
    <hr>

    <h2>Lisa film</h2>

    <form method="POST">
        <label for="titleInput">Filmi pealkiri</label>
        <input id="titleInput" name="titleInput" type="text"
               value="<%= titleInput ?? '' %>">
        <br>
         <label for="releaseYearInput">Väljalaskeaasta</label>
        <input id="releaseYearInput" name="releaseYearInput" type="number"
               value="<%= releaseYearInput ?? '' %>">
        <br>
        <label for="durationInput">Filmi pikkus minutites</label>
        <input id="durationInput" name="durationInput" type="number"
               value="<%= durationInput ?? '' %>">
        <br>
        <label for="descriptionInput">Filmi kirjeldus</label>
        <textarea id="descriptionInput" name="descriptionInput"><%= descriptionInput ?? '' %></textarea>
        <br>
        <input type="submit" value="Salvesta">
    </form>

    <p><%= notice %></p>
</body>
</html>
